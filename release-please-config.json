{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "10249b2fbd966a134e9234b3a6ce392ef343d71f",
  "release-type": "simple",
  "separate-pull-requests": true,
  "always-update": true,
  "packages": {
    ".": {
      "component": "worker",
      "package-name": "worker",
      "exclude-paths": [
        "apps/mobile",
        "ml",
        "docs",
        ".github",
        ".claude"
      ]
    },
    "apps/mobile": {
      "component": "mobile",
      "package-name": "mobile",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "json",
          "path": "app.json",
          "jsonpath": "$.expo.version"
        }
      ]
    }
  }
}
