# Copy to .env.local (gitignored) and fill in.

# Where the Worker is. On a device or emulator, localhost is the device itself: use your machine's
# LAN address for `wrangler dev` (e.g. http://192.168.1.20:8787), or http://10.0.2.2:8787 from the
# Android emulator. The WebSocket origin is derived from this (http -> ws, https -> wss).
EXPO_PUBLIC_API_ORIGIN=http://10.0.2.2:8787

# The Auth0 Native application (not the web app's SPA application) and the API both apps call.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=
